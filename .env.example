# ──────────────────────────────────────────────────────────────────────────────
# PawMatch — Plantilla de variables de entorno
# Copia este archivo como `.env` y rellena los valores reales.
# NUNCA commitees el archivo `.env` real al repositorio.
# ──────────────────────────────────────────────────────────────────────────────

# ── Django ────────────────────────────────────────────────────────────────────
# Genera una clave segura con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambia-esto-por-una-clave-secreta-segura

# Modo debug: True solo en desarrollo local, nunca en producción
DEBUG=True

# Hosts permitidos separados por coma (solo en producción)
# Ejemplo: ALLOWED_HOSTS=tudominio.com,www.tudominio.com
ALLOWED_HOSTS=

# ── Base de datos MySQL ───────────────────────────────────────────────────────
DATABASE_NAME=PawMatch
DATABASE_USER=pawmatch_user
DATABASE_PASSWORD=cambia-esto-por-una-contrasena-segura
DATABASE_HOST=localhost
DATABASE_PORT=3306

# Ruta al certificado CA de MySQL para conexión TLS (solo en producción)
# Ejemplo: MYSQL_SSL_CA=/etc/ssl/mysql/ca-cert.pem
MYSQL_SSL_CA=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Orígenes adicionales separados por coma (además de localhost:5173)
# Ejemplo: CORS_ORIGINS=https://tudominio.com
CORS_ORIGINS=

# ── OAuth Google ──────────────────────────────────────────────────────────────
GOOGLE_OAUTH2_CLIENT_ID=
GOOGLE_OAUTH2_CLIENT_SECRET=

# ── Proxy (solo si el servidor está detrás de un proxy inverso) ───────────────
# Activar para que la IP real del cliente se extraiga de X-Forwarded-For
# TRUST_X_FORWARDED_FOR=True
TRUST_X_FORWARDED_FOR=False

# ── Railway (producción) ──────────────────────────────────────────────────────
# Railway termina SSL en el proxy — mantener en False
SECURE_SSL_REDIRECT=False
# Ejemplo: ALLOWED_HOSTS=pawmatch-backend.up.railway.app
# Ejemplo: CORS_ORIGINS=https://pawmatch-frontend.up.railway.app
