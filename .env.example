# ──────────────────────────────────────────────────────────────────────────────
# PawMatch — Plantilla de variables de entorno
# Copia este archivo como `.env` y rellena los valores reales.
# NUNCA commitees el archivo `.env` real al repositorio.
# ──────────────────────────────────────────────────────────────────────────────

# ── Django ────────────────────────────────────────────────────────────────────
# Genera una clave segura con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambia-esto-por-una-clave-secreta-segura

# Modo debug: True solo en desarrollo local, nunca en producción
DEBUG=False

# IP del servidor Hetzner o dominio, separados por coma
ALLOWED_HOSTS=123.456.789.0,tudominio.com

# ── Base de datos MySQL ───────────────────────────────────────────────────────
DATABASE_NAME=PawMatch
DATABASE_USER=root
DATABASE_PASSWORD=contraseña-segura-aqui
DATABASE_HOST=db
DATABASE_PORT=3306

# Ruta al certificado CA de MySQL para conexión TLS (opcional)
MYSQL_SSL_CA=

# ── Redis (Django Channels) ───────────────────────────────────────────────────
# Dentro de Docker siempre apunta al servicio "redis" — no cambiar
REDIS_URL=redis://redis:6379/0

# ── CORS ──────────────────────────────────────────────────────────────────────
# Dominio(s) desde donde el frontend hace peticiones
CORS_ORIGINS=http://123.456.789.0,https://tudominio.com

# ── URLs del frontend (se embeben en el build de React) ──────────────────────
VITE_API_URL=http://123.456.789.0/api
VITE_SOCKET_URL=ws://123.456.789.0

# ── OAuth Google ──────────────────────────────────────────────────────────────
GOOGLE_OAUTH2_CLIENT_ID=
GOOGLE_OAUTH2_CLIENT_SECRET=

# ── HTTPS ─────────────────────────────────────────────────────────────────────
# Activar SOLO después de instalar certificado SSL con Certbot
HTTPS_ENABLED=False

# ── Proxy (Nginx delante de Django) ───────────────────────────────────────────
TRUST_X_FORWARDED_FOR=True
